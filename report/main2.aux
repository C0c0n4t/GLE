\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces Сравнение полной ошибки \(|u_{\mathrm  {num}} - u_{\mathrm  {an}}|\) (тёмные маркеры) и ошибки модуля \(\bigl  ||u_{\mathrm  {num}}| - |u_{\mathrm  {an}}|\bigr  |\) (светлые маркеры). Ошибка модуля занижает истинную погрешность и может маскировать проблемы с фазовой согласованностью схемы.}}{8}{}\protected@file@percent }
